{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "ES2024",
    "types": ["node", "@cap-js/cds-types"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
        "@models/*": ["./@cds-models/*/index.d.ts"]
    }
  },
    "include": ["srv"],
    "exclude": ["node_modules"]
}
