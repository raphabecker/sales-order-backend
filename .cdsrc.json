{
  "server": { "cors": false },
  "[development]": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "driver": "sql.js",
        "credentials": { "url": ":memory:" }
      },
      "auth": {
        "kind": "basic",
        "users": {
          "admin": { "password": "admin-local-only", "roles": ["admin"] },
          "sales": { "password": "sales-local-only", "roles": ["sales_rep"] },
          "reader": { "password": "reader-local-only", "roles": ["read_only_user"] },
          "*": false
        }
      }
    }
  }
}
