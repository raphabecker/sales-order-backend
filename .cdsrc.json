{
  "[development]": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": ":memory:"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "admin-dev": {
            "roles": ["admin"],
            "attr": {
              "id": 1,
              "groups": ["group1", "group2"]
            }
          },
          "reader-dev": {
            "roles": ["read_only_user"],
            "attr": {
              "id": 2,
              "groups": ["group1"]
            }
          }
        }
      }
    }
  }
}
