@base = http://127.0.0.1:4004/odata/v4/main
@customer = 38373147-201c-4e8d-bef6-165e14070769
@dock = 8dd64f22-69d8-4141-b402-9216d5677437

### Catalog
GET {{base}}/Products?$filter=stock gt 0&$orderby=name&$top=10
Authorization: Basic reader:reader-local-only

### Create: 2 x 299.90 = 599.80
# @name createOrder
POST {{base}}/SalesOrderHeaders
Authorization: Basic sales:sales-local-only
Content-Type: application/json

{
  "customers_id": "{{customer}}",
  "items": [{ "product_id": "{{dock}}", "quantity": 2 }]
}

### Inspect the order and its items; run createOrder first
GET {{base}}/SalesOrderHeaders({{createOrder.response.body.$.id}})?$expand=items,customers
Authorization: Basic reader:reader-local-only

### Cancel; repeating this restores stock only once
POST {{base}}/SalesOrderHeaders({{createOrder.response.body.$.id}})/MainService.cancel
Authorization: Basic sales:sales-local-only
Content-Type: application/json
If-Match: *

{}

### Inspect audit events as admin
GET {{base}}/SalesOrderLogs?$filter=header_id eq {{createOrder.response.body.$.id}}
Authorization: Basic admin:admin-local-only

### Reader cannot create an order: expect 403
POST {{base}}/SalesOrderHeaders
Authorization: Basic reader:reader-local-only
Content-Type: application/json

{
  "customers_id": "{{customer}}",
  "items": [{ "product_id": "{{dock}}", "quantity": 1 }]
}
