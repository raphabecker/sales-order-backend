@base = http://127.0.0.1:4004/odata/v4/main
@customer = 38373147-201c-4e8d-bef6-165e14070769

### List as reader
GET {{base}}/Customers
Authorization: Basic reader:reader-local-only

### Read selected properties
GET {{base}}/Customers({{customer}})?$select=id,firstName
Authorization: Basic reader:reader-local-only

### Create as admin; change the email before repeating
POST {{base}}/Customers
Authorization: Basic admin:admin-local-only
Content-Type: application/json

{
  "firstName": "Carla",
  "lastName": "Lima",
  "email": "carla@example.com"
}

### Update using an explicit wildcard version
PATCH {{base}}/Customers({{customer}})
Authorization: Basic admin:admin-local-only
Content-Type: application/json
If-Match: *

{
  "lastName": "Silva"
}
